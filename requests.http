# USERS TESTS

### Test 1: Get all users, NO AUTH (403)
// @no-cookie-jar
GET {{baseUrl}}/users
Content-Type: {{json}}

### Test 2: Get all users, ADMIN AUTH (200)
// @no-cookie-jar
GET {{baseUrl}}/users
Content-Type: {{json}}
Authorization: {{adminAuth}}

### Test 3: Get specific user, ADMIN AUTH (200)
// @no-cookie-jar
GET {{baseUrl}}/users/{{victorId}}
Content-Type: {{json}}
Authorization: {{adminAuth}}

### Test 4: Get specific user, USER AUTH (403)
// @no-cookie-jar
GET {{baseUrl}}/users/{{victorId}}
Content-Type: {{json}}
Authorization: {{userAuth}}

### Test 5a: Create new user, NO AUTH (201)
// @no-cookie-jar
PUT {{baseUrl}}/users/{{testUserId}}
Content-Type: {{json}}

{
	"login": "testuser",
	"email": "testuser@quickr.com",
	"birthDate": "2000-01-01",
	"password": "testusertestuser",
	"roles": ["user"]
}

### Test 5b: Test new user for user operation, USER AUTH (200)
// @no-cookie-jar
GET {{baseUrl}}/venues
Content-Type: {{json}}
Authorization: {{testUserAuth}}

### Test 5c: Test new user for admin operation, USER AUTH (403)
// @no-cookie-jar
GET {{baseUrl}}/venues/{{venueId}}
Content-Type: {{json}}
Authorization: {{testUserAuth}}

### Test 6: Get test user, ADMIN AUTH (200)
// @no-cookie-jar
